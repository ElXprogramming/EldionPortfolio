# Supabase Configuration
# Obtain these values from your Supabase Dashboard: Project Settings -> API
# Note: Only the public URL and public anon key (enforced by PostgreSQL RLS) may use the VITE_ prefix.
# Never expose service_role keys, database URIs, or admin credentials with VITE_.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
